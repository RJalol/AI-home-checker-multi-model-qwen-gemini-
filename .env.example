# Copy to .env and fill in what you use:  cp .env.example .env
# Real environment variables always win over this file.

# --- AI provider keys -------------------------------------------------------
# Set at least one. The tiered pipeline (hwchecker/) uses whichever are present:
# a tier whose key is missing is skipped in favour of the next usable provider.
GEMINI_API_KEY=        # hard photos (3.6 Flash) + audio tier + the medium tier's stand-in (Flash-Lite); also the original engine, and the only one that reads audio
QWEN_API_KEY=          # difficulty router + easy tier + medium tier (Qwen3.7 Plus) (DashScope international)
GLM_API_KEY=           # hard tier (text-only model: used for typed/DOCX work, never for photos)
ANTHROPIC_API_KEY=     # verification tier (Haiku second opinion; cheapest independent verifier).
                       # Optional: without it Gemini and Qwen check each other's grades (see verification_gemini/_qwen below)
OPENAI_API_KEY=        # cross-provider fallback

# --- Language of the AI's feedback -----------------------------------------
# Default: Uzbek (Latin script). Any language name works ("Russian", "English", ...);
# "auto" answers in the language of the student's work.
# FEEDBACK_LANGUAGE=Uzbek (Latin script)

# --- Tiered pipeline tuning (all optional) -----------------------------------
# Serve an identical re-submitted file from a cache instead of grading it again.
# HWCHECKER_ENABLE_CACHE=true
# Max grading calls per provider model per minute; 0 = no pacing (the default).
# HWCHECKER_RATE_LIMIT_PER_MINUTE=0

# --- Cost-optimised model set-up (all optional; the values shown ARE the defaults) -------------
# Each tier = a model + how much hidden "thinking" it may do (thinking tokens are billed as output).
#   tiers:     ROUTER, EASY, MEDIUM, MEDIUM_ALT, HARD, HARD_VISION, AUDIO, VERIFICATION, VERIFICATION_GEMINI, VERIFICATION_QWEN, FALLBACK
#   _MODEL     model name (same provider as the default)
#   _PROVIDER  qwen | gemini | glm | claude | openai   (only together with _MODEL)
#   _THINKING  off | low | medium | high | max | <token budget> | default (= the provider's own default)
# Default set-up:
#   ROUTER        qwen3.7-flash          thinking off
#   EASY          qwen3.5-flash          thinking off
#   MEDIUM        qwen3.7-plus           thinking low
#   MEDIUM_ALT    gemini-3.5-flash-lite  thinking low            (MEDIUM's stand-in when there is no Qwen key)
#   HARD          glm-5.2                reasoning_effort high   (text only; photos go to HARD_VISION)
#   HARD_VISION   gemini-3.6-flash       thinking high           (hard questions that arrive as photo/scan)
#   AUDIO         gemini-3.6-flash       thinking low            (recordings)
#   VERIFICATION  claude-haiku-5-5       provider default        (second opinion)
#   VERIFICATION_GEMINI gemini-3.5-flash-lite thinking low       (second opinion when Haiku is unavailable / graded it)
#   VERIFICATION_QWEN   qwen3.7-plus      thinking low            (second opinion for results graded by Gemini)
#   A second opinion always comes from a DIFFERENT vendor than the grader; the router tries the three
#   VERIFICATION* tiers in this order and takes the first usable one.
#   FALLBACK      gpt-5.4-mini           provider default
# Examples -- go back to the previous, more expensive set-up for a tier:
# HWCHECKER_MEDIUM_PROVIDER=gemini
# HWCHECKER_MEDIUM_MODEL=gemini-3.5-flash-lite
# HWCHECKER_HARD_VISION_PROVIDER=claude
# HWCHECKER_HARD_VISION_MODEL=claude-sonnet-5
# HWCHECKER_HARD_VISION_THINKING=default
# HWCHECKER_MEDIUM_THINKING=default
# HWCHECKER_VERIFICATION_MODEL=claude-sonnet-5
# Spend less on the verifier still (test quality first):
# HWCHECKER_VERIFICATION_THINKING=low
#
# A result is re-checked by the VERIFICATION tier when its confidence is below the threshold or its score
# is within MARGIN points of a band boundary (40 / 70 / 90). Lower = fewer re-checks = cheaper.
# HWCHECKER_VERIFY_CONFIDENCE_THRESHOLD=0.70
# HWCHECKER_VERIFY_SCORE_MARGIN=2.0

# --- Output cap and spend alerts (all optional, off by default) --------------------------
# Max reply size for every provider (never below 1024; Gemini counts its thinking tokens in it).
# HWCHECKER_MAX_OUTPUT_TOKENS=4096
# Spend watch-dog: logs a warning at 80% and 100% of the budget (UTC day / month). Never limits grading.
# HWCHECKER_DAILY_BUDGET_USD=40
# HWCHECKER_MONTHLY_BUDGET_USD=900

# --- Uploads ----------------------------------------------------------------
# Photos are rotated upright and shrunk to this many pixels on the longest side (fewer image tokens).
# Raise to 2400 if small handwriting starts being misread.
# MAX_IMAGE_SIDE_PX=1568

# --- Infrastructure -----------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/homework_checker

# --- Security -----------------------------------------------------------------
# REQUIRED: while this is empty every protected endpoint answers 503. Use a long random string.
INTERNAL_API_KEY=
# Local development ONLY: serve the protected endpoints without a key.
# ALLOW_UNAUTHENTICATED_API=false
# Browser origins allowed by CORS (comma-separated). Empty = CORS off.
# CORS_ALLOW_ORIGINS=https://crm.example.com
# Master value for webhook signatures (X-Webhook-Signature). Empty = INTERNAL_API_KEY is used.
# WEBHOOK_SIGNING_SECRET=
# Webhook targets must be https + public. Dev only: allow http/private targets.
# WEBHOOK_ALLOW_PRIVATE_URLS=false
# WEBHOOK_ALLOWED_HOSTS=crm.internal

# --- Privacy -------------------------------------------------------------------
# Copy approved student work into training_data/ for fine-tuning. OFF by default: enable only with
# consent and a retention/deletion process.
# COLLECT_TRAINING_DATA=false

# --- Reliability ---------------------------------------------------------------
# Submissions still "pending_ai" this long with no live job are re-queued by reconcile.py ...
# RECONCILE_REQUEUE_AFTER_SECONDS=300
# ... at most this many times, then marked grading_failed.
# RECONCILE_MAX_REQUEUES=3
# Hard limit for one model call (seconds). A job is stopped at JOB_TIMEOUT_SECONDS (default 300).
# PROVIDER_TIMEOUT_SECONDS=120
